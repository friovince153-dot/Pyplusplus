def is_prime(n):
    if n < 2:
        return False
    d = 2
    while d * d <= n:
        if n % d == 0:
            return False
        d += 1
    return True

primes = []
for n in range(2, 31):
    if is_prime(n):
        append(primes, n)
print("Primes up to 30:", primes)
print("How many:", len(primes))
print("Sum:", sum(primes))
